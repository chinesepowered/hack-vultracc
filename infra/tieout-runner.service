[Unit]
Description=Tieout sandbox runner (gVisor containers, private VPC address only)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/tieout/runner.env
WorkingDirectory=/opt/tieout/current/services/runner
ExecStart=/usr/local/bin/uv run --frozen --no-dev uvicorn runner.app:app --host ${RUNNER_BIND} --port 7070 --timeout-keep-alive 75
Restart=always
RestartSec=3
Environment=UV_CACHE_DIR=/var/cache/uv
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
