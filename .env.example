# Copy to .env and fill in. Never commit .env.
VULTR_API_KEY=                 # account API; only for infra scripts (provision/deploy)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL_MAIN=                # GLM 5.3 id from GET /v1/models
LLM_MODEL_FAST=                # GLM 5.3 Flash id (fallback)
LLM_MODEL_SAFETY=              # Nemotron 3.5 Content Safety id (optional)
LLM_REASONING_EFFORT=          # low | medium | high (optional; the deploy uses medium)
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:PORT/DB?sslmode=require
DATABASE_URL_VULTR=            # written by infra/provision.py (Vultr Managed PostgreSQL)
S3_ENDPOINT=https://sjc1.vultrobjects.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
SANDBOX_RUNNER_URL=http://10.x.x.x:7070   # VPC address of the sandbox host
SANDBOX_RUNNER_TOKEN=          # local dev runner token
SANDBOX_RUNNER_TOKEN_VULTR=    # production runner token (written by provision.py)
SANDBOX_IMAGE=tieout-sandbox:latest
APP_BASE_URL=https://...
SESSION_SECRET=
MAX_CONCURRENT_SANDBOXES=16
MAX_CONCURRENT_RUNS=12
DAILY_TOKEN_BUDGET=8000000
SANDBOX_RUNNER_URLS=           # optional: several sandbox hosts, comma separated
SANDBOX_HOSTS=1                # infra/provision.py: how many sandbox hosts to create (extra hosts are optional)
BATCHES_PER_USER_PER_HOUR=20
BATCHES_PER_IP_PER_HOUR=12
KILL_SWITCH_AUTO_RESUME_MIN=0  # public demo: 15 so one visitor cannot lock everyone out
LOCAL_PG_PASSWORD=             # only when the managed database does not fit (local Postgres container)
TTS_MODEL=xtts                 # scripts/make_video.py (Vultr text-to-speech)
TTS_VOICE=
ELEVENLABS_API_KEY=            # scripts/make_video.py --engine elevenlabs (video narration only; never used by the product)
ELEVENLABS_VOICE_ID=
# Reconcile your own files (optional; defaults 6 per hour, 3 at once)
UPLOADS_PER_IP_PER_HOUR=
MAX_CONCURRENT_UPLOADS=
